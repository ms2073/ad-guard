{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(python3 -m evals.run:*)",
      "Bash(.venv/bin/python -m evals.run:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/python -m adguard.pipeline:*)",
      "Bash(python3 -m adguard.pipeline:*)",
      "Bash(pytest:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(cat feedback.jsonl)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push:*)",
      "Bash(pip install:*)"
    ]
  },
  "env": {
    "ADGUARD_MODEL": "z-ai/glm-5.3-flash-ultrafast",
    "ADGUARD_DECISION_MODEL": "sionic-ai/jev-omni"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/eval-on-prompt-change.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
