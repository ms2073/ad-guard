{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(python3 -m evals.run:*)",
      "Bash(python3 -m adguard.pipeline:*)",
      "Bash(pytest:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(cat feedback.jsonl)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push:*)",
      "Bash(pip install:*)"
    ]
  },
  "env": {
    "ADGUARD_MODEL": "claude-sonnet-5-5",
    "ADGUARD_SMALL_MODEL": "claude-haiku-5-5"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/eval-on-prompt-change.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
